<script>
  // A $( document ).ready() block.
  const mySelector = {
    level:-1,
    start: false
  }

 function select(id,lvl){
  $('.customcard').removeClass('customcardselected');
  $(`#${id}`).addClass('customcardselected');
  mySelector.level = lvl
 }

 function gameStart(){
  id = $(".active").prop("id")
  lvl = parseInt(id)
  mySelector.level = lvl
  mySelector.start = true
    if (mySelector.level == -1) {
      alert("Choose your fuckn enemy")
      return
    } else {
      location.href = `/game/${mySelector.level}`
    }
 }
</script>