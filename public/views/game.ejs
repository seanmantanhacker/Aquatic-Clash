<!DOCTYPE html>
<html lang="en" translate="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aquatic Clash - Battle Arena</title>
  <link rel="icon" href="/image/bebe.jpg" type="image/x-icon">
  
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/style-game.css">

  <audio id="bgmSukuna" src="/bgm/sukuna_ost.mp3" loop></audio>
  <audio id="sfxVoice" src="/bgm/sukuna_gambare_gambare.wav"></audio>
</head>
<body>

  <div class="game-container">
    <!-- Top Navigation -->
    <nav class="game-nav">
      <a href="/" class="nav-link-btn">
        <i class="fa-solid fa-arrow-left"></i> Menu Utama
      </a>
      <div class="nav-actions">
        <button class="icon-btn" id="audioBtn" title="Toggle Music" onclick="toggleAudio()">
          <i class="fa-solid fa-volume-high" id="audioIcon"></i>
        </button>
      </div>
    </nav>

    <!-- Battle HUD Header -->
    <section class="battle-hud">
      <div class="hud-grid">
        <!-- Player Avatar -->
        <div class="fighter-slot">
          <div class="fighter-avatar active-turn" id="playerAvatarBox">
            <img src="/image/orang.png" alt="Player">
          </div>
          <span class="fighter-label" style="color: var(--cyan-neon);">YOU</span>
        </div>

        <!-- Center Battle Status -->
        <div class="hud-center">
          <div class="hud-level-badge" id="levelBadge">LEVEL <%-lvl%></div>
          <div class="hud-turn-title turn-player" id="turnTitle">GILIRAN ANDA</div>
          <div class="hud-dialogue" id="dialogueText">Pilih salah satu ember di bawah dan kurangi airnya.</div>
        </div>

        <!-- Enemy Avatar -->
        <div class="fighter-slot">
          <div class="fighter-avatar" id="enemyAvatarBox">
            <img src="<%=enemy%>" alt="Enemy" id="enemyImg">
          </div>
          <span class="fighter-label" style="color: var(--pink-neon);" id="enemyNameTag">ENEMY</span>
        </div>
      </div>
    </section>

    <!-- Gallons / Ember Arena (3 Buckets) -->
    <section class="gallons-grid">
      <!-- Gallon 1 -->
      <div class="gallon-card selected" id="cardEmber1" onclick="selectGallon(0)">
        <div class="gallon-badge">EMBER 1</div>
        <div class="gallon-icon">
          <img src="/image/ember.png" alt="Ember 1">
        </div>
        <div class="gallon-amount" id="ember1">0</div>
        <div class="gallon-unit">Liter</div>
        <div class="water-gauge-container">
          <div class="water-gauge-fill" id="gauge1" style="width: 100%;"></div>
        </div>
      </div>

      <!-- Gallon 2 -->
      <div class="gallon-card" id="cardEmber2" onclick="selectGallon(1)">
        <div class="gallon-badge">EMBER 2</div>
        <div class="gallon-icon">
          <img src="/image/ember.png" alt="Ember 2">
        </div>
        <div class="gallon-amount" id="ember2">0</div>
        <div class="gallon-unit">Liter</div>
        <div class="water-gauge-container">
          <div class="water-gauge-fill" id="gauge2" style="width: 100%;"></div>
        </div>
      </div>

      <!-- Gallon 3 -->
      <div class="gallon-card" id="cardEmber3" onclick="selectGallon(2)">
        <div class="gallon-badge">EMBER 3</div>
        <div class="gallon-icon">
          <img src="/image/ember.png" alt="Ember 3">
        </div>
        <div class="gallon-amount" id="ember3">0</div>
        <div class="gallon-unit">Liter</div>
        <div class="water-gauge-container">
          <div class="water-gauge-fill" id="gauge3" style="width: 100%;"></div>
        </div>
      </div>
    </section>

    <!-- Control Panel -->
    <section class="control-panel">
      <div class="selected-gallon-indicator">
        <div class="indicator-title">
          <i class="fa-solid fa-hand-pointer text-cyan"></i> Target Terpilih
        </div>
        <div class="indicator-val" id="targetIndicator">Ember 1 (0 L Tersedia)</div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="quick-buttons">
        <button class="quick-btn" type="button" onclick="setReduction(1)">-1 L</button>
        <button class="quick-btn" type="button" onclick="setReduction(5)">-5 L</button>
        <button class="quick-btn" type="button" onclick="setReductionPercent(0.5)">50%</button>
        <button class="quick-btn" type="button" onclick="setReductionAll()">Habiskan</button>
      </div>

      <!-- Input and Execute Button -->
      <div class="input-row">
        <input id="reductionInput" class="input-cyber" type="number" min="1" placeholder="Jumlah liter..." />
        <button id="submitBtn" class="btn-execute" onclick="submitMove()">
          <i class="fa-solid fa-droplet"></i> Ambil Air
        </button>
      </div>
    </section>

    <!-- Notification Toast Container -->
    <div class="alert-container">
      <div class="cyber-alert cyber-alert-danger d-none" id="alertBox"></div>
      <div class="cyber-alert cyber-alert-success d-none" id="successBox"></div>
    </div>
  </div>

  <!-- Victory / Defeat Modal -->
  <div class="modal fade" id="resultModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="resultModalTitle">Hasil Pertandingan</h5>
        </div>
        <div class="modal-body" id="resultModalBody">
          <!-- Dynamically filled -->
        </div>
        <div class="modal-footer">
          <a href="/" class="btn-cyber-secondary" style="text-decoration:none;">Pilih Lawan Lain</a>
          <button type="button" class="btn-cyber-primary" onclick="restartMatch()">Tanding Ulang</button>
        </div>
      </div>
    </div>
  </div>

  <!-- jQuery & Bootstrap -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const level = parseInt("<%-lvl%>") || 1;
    const bgmAudio = document.getElementById('bgmSukuna');
    const sfxVoice = document.getElementById('sfxVoice');
    const audioIcon = document.getElementById('audioIcon');
    let isMuted = false;

    let gallons = [0, 0, 0];
    let maxGallons = [0, 0, 0];
    let selectedGallonIndex = 0;
    let isPlayerTurn = true;
    let dialogueInterval = null;

    const resultModal = new bootstrap.Modal(document.getElementById('resultModal'), {
      backdrop: 'static',
      keyboard: false
    });

    // Enemy names list
    const enemyNames = {
      1: "Cumis",
      2: "Patrick Star",
      3: "Bot Tolol",
      4: "Riggo Star",
      5: "Ryomen Sukuna",
      6: "Sha7n",
      7: "Master MIND",
      8: "NUNCHI OVERLORD"
    };

    // Apply boss themes
    if (level === 7) {
      document.body.classList.add('level-7');
    } else if (level === 8) {
      document.body.classList.add('level-8');
      document.getElementById('levelBadge').style.borderColor = 'var(--purple-neon)';
      document.getElementById('levelBadge').style.color = 'var(--purple-neon)';
      document.getElementById('levelBadge').textContent = 'LEVEL 8 (IMPOSSIBLE)';
    }

    // Set enemy name tag
    document.getElementById('enemyNameTag').textContent = (enemyNames[level] || `BOT LVL ${level}`).toUpperCase();

    // Start background audio if level >= 5
    if (level >= 5) {
      bgmAudio.volume = 0.25;
      bgmAudio.play().catch(() => {
        // Autoplay policy prevented immediate playback; wait for user interaction
      });
    }

    function toggleAudio() {
      if (isMuted) {
        bgmAudio.volume = 0.25;
        bgmAudio.play().catch(() => {});
        audioIcon.className = 'fa-solid fa-volume-high';
        isMuted = false;
      } else {
        bgmAudio.pause();
        audioIcon.className = 'fa-solid fa-volume-xmark';
        isMuted = true;
      }
    }

    // Intimidation Dialogue
    function triggerBossDialogue() {
      let lines = [];
      if (level === 8) {
        lines = [
          "Kalkulasi nunchi: Posisi kemenangan mutlak berada di pihakku.",
          "Setiap tetes air yang kamu kurangi hanya mempercepat kekalahanmu.",
          "Bouton's Theorem telah membuktikan: tidak ada jalan keluar bagimu.",
          "Status P-Position terkunci sempurna. Langkahmu sia-sia.",
          "Peluang menangmu tetap 0.0000%."
        ];
      } else if (level === 7) {
        lines = [
          "Kamu butuh latihan 1000 tahun untuk mengalahkanku.",
          "HaHaHa! Tampaknya kamu akan kalah dalam beberapa langkah.",
          "Terlalu mudah bagiku, kawan.",
          "Hanya segini kemampuanmu?",
          "Kita akhiri ini dengan cepat."
        ];
      }

      if (lines.length > 0) {
        const randLine = lines[Math.floor(Math.random() * lines.length)];
        $('#dialogueText').text(`"${randLine}"`);
      }
    }

    // Initialise Game values
    function initializeGame() {
      if (level === 8) {
        // Level 8 (Impossible): Starting state locked to Nim-Sum == 0
        // Since player moves first, this mathematically forces the player into a losing position (P-position).
        // Numbers are <= 40, distinct, and randomized without obvious patterns.
        let g1, g2, g3;
        do {
          g1 = Math.floor(Math.random() * 32) + 8; // 8 .. 39
          g2 = Math.floor(Math.random() * 32) + 8; // 8 .. 39
          g3 = g1 ^ g2;
        } while (
          g3 < 5 || 
          g3 > 40 || 
          g1 === g2 || 
          g2 === g3 || 
          g1 === g3
        );

        // Randomly shuffle array order so the XOR relation isn't tied to any fixed bucket index
        gallons = [g1, g2, g3].sort(() => Math.random() - 0.5);
      } else if (level === 7) {
        let g1, g2, g3;
        g2 = Math.floor(Math.random() * 16) + 15;
        do {
          g1 = Math.floor(Math.random() * 65) + 35;
          g3 = Math.floor(Math.random() * 65) + 35;
        } while (Math.abs(g1 - g3) < 6);
        gallons = [g1, g2, g3];
      } else if (level === 6) {
        gallons = [
          Math.floor(Math.random() * 90) + 7,
          Math.floor(Math.random() * 80) + 6,
          Math.floor(Math.random() * 50) + 7
        ];
      } else {
        gallons = [
          Math.floor(Math.random() * 40) + 5,
          Math.floor(Math.random() * 50) + 5,
          Math.floor(Math.random() * 60) + 5
        ];
      }

      maxGallons = [...gallons];
      updateUI();
      selectGallon(0);

      if (level >= 7) {
        dialogueInterval = setInterval(triggerBossDialogue, 8000);
      }
    }

    function selectGallon(index) {
      if (!isPlayerTurn) return;
      if (gallons[index] <= 0) {
        showAlert(`Ember ${index + 1} sudah kosong! Silakan pilih ember lain.`);
        return;
      }

      selectedGallonIndex = index;
      $('.gallon-card').removeClass('selected');
      $(`#cardEmber${index + 1}`).addClass('selected');

      $('#targetIndicator').text(`Ember ${index + 1} (${gallons[index]} L Tersedia)`);
      $('#reductionInput').val('');
      $('#reductionInput').focus();
    }

    function setReduction(amount) {
      if (!isPlayerTurn) return;
      const current = gallons[selectedGallonIndex];
      const target = Math.min(amount, current);
      $('#reductionInput').val(target);
    }

    function setReductionPercent(pct) {
      if (!isPlayerTurn) return;
      const current = gallons[selectedGallonIndex];
      const target = Math.max(1, Math.floor(current * pct));
      $('#reductionInput').val(target);
    }

    function setReductionAll() {
      if (!isPlayerTurn) return;
      $('#reductionInput').val(gallons[selectedGallonIndex]);
    }

    function updateUI() {
      for (let i = 0; i < 3; i++) {
        $(`#ember${i + 1}`).text(gallons[i]);
        const pct = maxGallons[i] > 0 ? Math.max(0, (gallons[i] / maxGallons[i]) * 100) : 0;
        $(`#gauge${i + 1}`).css('width', `${pct}%`);

        if (gallons[i] <= 0) {
          $(`#cardEmber${i + 1}`).addClass('empty');
        } else {
          $(`#cardEmber${i + 1}`).removeClass('empty');
        }
      }

      const curVal = gallons[selectedGallonIndex];
      if (curVal > 0) {
        $('#targetIndicator').text(`Ember ${selectedGallonIndex + 1} (${curVal} L Tersedia)`);
      } else {
        // Auto-switch to next available gallon
        const nextAvail = gallons.findIndex(g => g > 0);
        if (nextAvail !== -1) {
          selectGallon(nextAvail);
        } else {
          $('#targetIndicator').text("Semua ember telah kosong.");
        }
      }
    }

    function showAlert(text) {
      $('#successBox').addClass('d-none');
      $('#alertBox').text(text).removeClass('d-none');
      setTimeout(() => $('#alertBox').addClass('d-none'), 3500);
    }

    function showSuccess(text) {
      $('#alertBox').addClass('d-none');
      $('#successBox').text(text).removeClass('d-none');
      setTimeout(() => $('#successBox').addClass('d-none'), 3500);
    }

    function submitMove() {
      if (!isPlayerTurn) return;

      const inputVal = $('#reductionInput').val().trim();
      if (!inputVal) {
        showAlert("Masukkan jumlah air yang ingin dikurangi!");
        return;
      }

      const amount = parseInt(inputVal);
      if (isNaN(amount) || amount <= 0) {
        showAlert("Jumlah pengurangan air harus lebih dari 0!");
        return;
      }

      if (amount > gallons[selectedGallonIndex]) {
        showAlert(`Air tidak mencukupi! Ember ${selectedGallonIndex + 1} hanya berisi ${gallons[selectedGallonIndex]} liter.`);
        return;
      }

      // Execute Player Move
      gallons[selectedGallonIndex] -= amount;
      updateUI();
      showSuccess(`Anda mengambil ${amount} liter dari Ember ${selectedGallonIndex + 1}.`);
      $('#reductionInput').val('');

      // Check if player won
      if (gallons.every(g => g <= 0)) {
        handleGameOver(true);
        return;
      }

      // Switch to Computer Turn
      triggerComputerTurn();
    }

    function triggerComputerTurn() {
      isPlayerTurn = false;
      document.getElementById('submitBtn').disabled = true;

      // Update HUD states
      $('#playerAvatarBox').removeClass('active-turn');
      $('#enemyAvatarBox').addClass('enemy-turn');
      $('#turnTitle').removeClass('turn-player').addClass('turn-enemy').text("GILIRAN KOMPUTER...");
      $('#dialogueText').text("Komputer sedang menganalisis strategi terbaik...");

      if (level === 6 && !isMuted) {
        sfxVoice.play().catch(() => {});
      }

      // Available gallons
      const availableIndices = gallons
        .map((g, idx) => (g > 0 ? idx : null))
        .filter(idx => idx !== null);

      if (availableIndices.length === 0) {
        handleGameOver(true);
        return;
      }

      // Fetch AI Move
      if (level === 8) {
        // Level 8: Pure Optimal Nim-Sum API
        $.ajax({
          url: '/api/get-data-by-algoritma-master-lvl8',
          method: 'POST',
          dataType: 'json',
          contentType: 'application/json',
          data: JSON.stringify(gallons),
          success: function(resp) {
            executeComputerStep(resp.index, resp.amount);
          },
          error: function() {
            // Fallback in case of network glitch: execute optimal client-side
            const s = gallons[0] ^ gallons[1] ^ gallons[2];
            let idx = availableIndices[0];
            let amt = 1;
            if (s !== 0) {
              for (let i = 0; i < 3; i++) {
                if ((gallons[i] ^ s) < gallons[i]) {
                  idx = i;
                  amt = gallons[i] - (gallons[i] ^ s);
                  break;
                }
              }
            }
            executeComputerStep(idx, amt);
          }
        });
      } else if (level === 7) {
        $.ajax({
          url: '/api/get-data-by-algoritma-master-lvl7',
          method: 'POST',
          dataType: 'json',
          contentType: 'application/json',
          data: JSON.stringify(gallons),
          success: function(resp) {
            executeComputerStep(resp.index, resp.amount);
          }
        });
      } else if (level === 6) {
        $.ajax({
          url: '/api/get-data-by-algoritma-master',
          method: 'POST',
          dataType: 'json',
          contentType: 'application/json',
          data: JSON.stringify(gallons),
          success: function(resp) {
            executeComputerStep(resp.index, resp.amount);
          }
        });
      } else {
        // Levels 1 to 5: Local Logic
        let targetIdx;
        if (level === 1) {
          // Random
          targetIdx = availableIndices[Math.floor(Math.random() * availableIndices.length)];
        } else if (level <= 4) {
          // Pick maximum pile
          targetIdx = availableIndices.reduce((maxI, curI) => (gallons[curI] > gallons[maxI] ? curI : maxI), availableIndices[0]);
        } else if (level === 5) {
          // Pick minimum pile
          targetIdx = availableIndices.reduce((minI, curI) => (gallons[curI] < gallons[minI] ? curI : minI), availableIndices[0]);
        }

        const amount = Math.floor(Math.random() * gallons[targetIdx]) + 1;
        executeComputerStep(targetIdx, amount);
      }
    }

    function executeComputerStep(idx, amount) {
      // Ensure validity
      const safeIdx = (idx >= 0 && idx < 3 && gallons[idx] > 0) ? idx : gallons.findIndex(g => g > 0);
      const safeAmount = Math.min(amount || 1, gallons[safeIdx]);

      // Delay for realistic pacing (1.6s)
      setTimeout(() => {
        gallons[safeIdx] -= safeAmount;
        updateUI();
        showSuccess(`Komputer mengambil ${safeAmount} liter dari Ember ${safeIdx + 1}!`);

        if (gallons.every(g => g <= 0)) {
          handleGameOver(false);
          return;
        }

        // Return turn to player
        isPlayerTurn = true;
        document.getElementById('submitBtn').disabled = false;
        $('#enemyAvatarBox').removeClass('enemy-turn');
        $('#playerAvatarBox').addClass('active-turn');
        $('#turnTitle').removeClass('turn-enemy').addClass('turn-player').text("GILIRAN ANDA");
        $('#dialogueText').text("Pilih ember dan tentukan jumlah air yang ingin dikurangi.");
      }, 1600);
    }

    function handleGameOver(playerWon) {
      if (dialogueInterval) clearInterval(dialogueInterval);

      if (playerWon) {
        $('#resultModalTitle').text("VICTORY!").css('color', 'var(--cyan-neon)');
        $('#resultModalBody').html(`
          <div style="font-size: 3rem; margin-bottom: 0.5rem;">🏆</div>
          <h3 style="color: var(--cyan-neon); font-weight: 800;">SELAMAT, ANDA MENANG!</h3>
          <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem;">
            Anda berhasil mengambil tetes air terakhir dan mengalahkan ${enemyNames[level] || 'Lawan'}!
          </p>
        `);
      } else {
        $('#resultModalTitle').text("DEFEAT").css('color', 'var(--danger-neon)');
        $('#resultModalBody').html(`
          <div style="font-size: 3rem; margin-bottom: 0.5rem;">💀</div>
          <h3 style="color: var(--danger-neon); font-weight: 800;">ANDA KALAH!</h3>
          <p style="color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem;">
            ${enemyNames[level] || 'Komputer'} telah mengambil tetes air terakhir dan menguasai permainan.
          </p>
        `);
      }

      resultModal.show();
    }

    function restartMatch() {
      resultModal.hide();
      isPlayerTurn = true;
      document.getElementById('submitBtn').disabled = false;
      $('#enemyAvatarBox').removeClass('enemy-turn');
      $('#playerAvatarBox').addClass('active-turn');
      $('#turnTitle').removeClass('turn-enemy').addClass('turn-player').text("GILIRAN ANDA");
      $('#dialogueText').text("Pilih salah satu ember di bawah dan kurangi airnya.");
      initializeGame();
    }

    $(document).ready(function() {
      initializeGame();
    });
  </script>
</body>
</html>