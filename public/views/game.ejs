
<html lang="en" translate="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aquatic Clash V1.0</title>
  
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/style-game.css">

  <link rel="icon" href="/image/bebe.jpg" type="image/x-icon">
  <audio id="background-audio" src="/bgm/sukuna_ost.mp3" autoplay></audio>
  <audio id="background-audio2" src="/bgm/sukuna_gambare_gambare.wav"></audio>
  
</head>
<body>

  <!-- Bootstrap Container -->
 
  <div class="container-fluid"> 
      <div class="row">
        <div class="col-2">
          <img src="/image/orang.png" class="customimage" id="image-1" alt="Italian Trulli">
      </div>
        <div class="col-8">
            <h1>Welcome to Aquatic Clash (lvl <%-lvl%>) </h1>
            <h2 id="turn">Player Turn</h2>
        </div>
        <div class="col-2">
          <img src="<%=enemy%>" class="customimage d-none" id="image-2" alt="Italian Trulli">
      </div>
    </div>

    <div class="row">
      <div class="col-md-12">
        
      </div>
  </div>
   
  <div class="row">
    
      <div class="col-4">
        <div id="cumis" class="shadow customcard ember">
          <div id="ember1" class="mycard">00</div>
        </div>
      </div>

      <div class="col-4">
        <div id="pat" class="shadow customcard ember">
          <div id="ember2" class="mycard">00</div>
        </div>
      </div>
      <div class="col-4">
        <div id="kaesar" class="shadow customcard ember">
          <div id="ember3" class="mycard">00</div>
        </div>
      </div>

</div>

<div class="row">
  <h2 id="info">masukan jumlah air yang ingin dikurang </h2>
</div>

<div class="row">
    
  <div class="col-4">
    
    <input id="input1" type="number">
  </div>

  <div class="col-4">
    <input id="input2" type="number">
  </div>
  <div class="col-4">
    <input id="input3" type="number">
  </div>

</div>

<div class="row">
    
  <button id="submit" class="button-40" onclick="submit()" role="button">Ambil</button>
  <div class="alert alert-danger d-none" id="addItemAlert" role="alert">
    alert
  </div>
  <div class="alert alert-success d-none" id="addsucAlert" role="alert">
    alert
  </div>
</div>

  </div>

  <!-- jQuery -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <!-- Bootstrap Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
  
</body>

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ...
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

</html>

<script>
  function wordevery5sec() {
    console.log("aa")
    kalimat = {
      1 : "Kamu butuh latihan 1000 tahun untuk mengalahkanku",
      2 : "HaHaHaHaaaa Tampaknya kamu akan kalah",
      3 : "Terlalu Mudah Bagiku kawan",
      4 : "Hanya segini saja kemampuanmu ?",
      5 : "Kita akhiri saja dengan cepat",
      6 : "Hebat Juga gerakanmu, patut diberikan sekotak sampah",
      7 : "Masukan Jumlah Air yang Ingin Dikurangi",
    }
    random = Math.floor(Math.random() * 7) + 1;
    $("#info").text(kalimat[random])
  }

  const audio2 = document.getElementById('background-audio2');
  const audio = document.getElementById('background-audio');
  level = <%-lvl%>;
  if (level == 7){
    document.body.style.backgroundImage = 'url("/image/bg7.png")';
    $(".mycard").addClass("white")
    $("#turn").addClass("white")
    $("#info").addClass("white")
    // Delay the first execution by 1 second
    setTimeout(() => {
        wordevery5sec(); // Execute after 1 second
        setInterval(wordevery5sec, 10000);
    }, 20000);
  
  }

  if (level < 6){
    audio.pause()
  }
  let gallons = []
  const myModal = new bootstrap.Modal('#staticBackdrop', {
    keyboard: false
  })
  $('#staticBackdrop').on('hidden.bs.modal', function () {
    window.location.href = "/"
  })

  
 // Inisialisasi permainan
function initializeGame() {  

  audio.volume = 0.3; // 50% volume   
  if (level > 6){
    gallon2= Math.floor(Math.random() * (30 - 15 + 1)) + 15;
    do {
      gallon1=  Math.floor(Math.random() * (99 - 35 + 1)) + 35;
      gallon3= Math.floor(Math.random() * (99 - 35 + 1)) + 35;
    } while (Math.abs( gallon1 -  gallon3) < 6); // Ensure b and c differ by at least 6

  } else if (level == 6) {  
    gallon1=  Math.floor(Math.random() * 90) + 7,
    gallon2=  Math.floor(Math.random() * 80) + 6,
    gallon3=  Math.floor(Math.random() * 50) + 7
  } else {
    gallon1=  Math.floor(Math.random() * 40) + 1,
    gallon2=  Math.floor(Math.random() * 50) + 1,
    gallon3=  Math.floor(Math.random() * 60) + 1
  }
  
  $("#ember1").text(gallon1)
  $("#ember2").text(gallon2)
  $("#ember3").text(gallon3)

  gallons=[gallon1,gallon2,gallon3]

}

function startGame(level) {   
  playerTurn(level);
}

function addAlert(text){
  $("#addItemAlert").text(text)
  $("#addItemAlert").removeClass("d-none")
    setTimeout(function(){
        $("#addItemAlert").addClass("show")
    },200)

    setTimeout(function(){
        $("#addItemAlert").removeClass("show")
        
        setTimeout(function(){
          $("#addItemAlert").addClass("d-none")
        },200)
    },3000)
}

function sucAlert(text){
  $("#addsucAlert").text(text)
  $("#addsucAlert").removeClass("d-none")
    setTimeout(function(){
        $("#addsucAlert").addClass("show")
    },200)

    setTimeout(function(){
        $("#addsucAlert").removeClass("show")
        
        setTimeout(function(){
          $("#addsucAlert").addClass("d-none")
        },200)
    },3000)
}

function submit(){
  
  input1 = $("#input1").val()
  input2 = $("#input2").val()
  input3 = $("#input3").val()
 amount = 0
 index = 0

 if (input1 == '' && input2 == '' && input3 == ''){
  addAlert("input tidak boleh kosong")
  return;
 } else {
  if (input1 >0){
    amount = parseInt(input1)
    index = 0
  } else if (input2 > 0){
    amount = parseInt(input2)
    index = 1
  } else if (input3 > 0){
    amount = parseInt(input3)
    index = 2
  }

  if (amount == 0){
    addAlert("pengurangan air tidak boleh 0")
    return
  }

 }
 if (gallons[index] > 0) {
      // Syarat: Input tidak boleh sama dengan nilai galon
      if (amount <= gallons[index]) {
          gallons[index] = parseInt(gallons[index]) - parseInt(amount) ; // Mengubah air dalam galon
          text = `Galon ${index + 1} diubah menjadi ${gallons[index]}.`
          sucAlert(text)
          no = `#ember${index+1}`
          
          $(no).text(gallons[index])
          
          $("#input2").val("")
          $("#input1").val("")
          $("#input3").val("")
          availableGallons = gallons
          .map((g, index) => (g > 0 ? index : null))
          .filter(index => index !== null);

          if (availableGallons.length === 0) {
            
            sucAlert("Semua galon kosong PLAYER menang")
            $(".modal-body").text("CONGRATULATIONS YOU WIN")
            myModal.show()
            return;
          }
          computerTurn(level);  // Giliran komputer
      } else {
        addAlert("Syarat tidak terpenuhi! Pastikan mengurangi air yang valid! Silakan pilih ulang.")
        return
      }
  } else {
    addAlert("Galon sudah kosong! Silakan pilih galon lain.")
    return
  }

}

function playerTurn(level) {
    // Pemain A memasukkan input dalam bentuk [nilai, galon]
    if (level ==6){
      audio2.play()
  }
    
    $("#image-2").addClass("d-none")
    $("#image-1").removeClass("d-none")
    document.getElementById("submit").disabled = false;
    $("#turn").text("Player turn")
   
}

function computerTurn(level) {
  $("#image-1").addClass("d-none")
  $("#image-2").removeClass("d-none")
  document.getElementById("submit").disabled = true;
  $("#turn").text("Computer turn")
    // Komputer memilih galon yang berisi air

    let gallonIndex;
    if (level === 1) {
        // Strategi termudah: Komputer memilih galon acak
        gallonIndex = availableGallons[Math.floor(Math.random() * availableGallons.length)];
    } else if (level <= 4) {
        // Strategi menengah hingga sulit: Komputer memilih galon dengan air maksimum
        gallonIndex = availableGallons.reduce((maxIndex, currentIndex) => {
            return gallons[currentIndex] > gallons[maxIndex] ? currentIndex : maxIndex;
        }, availableGallons[0]);
    } else if (level == 5) {
        // Level 5: Strategi hampir mustahil, memilih galon yang menyisakan sedikit air
        gallonIndex = availableGallons.reduce((minIndex, currentIndex) => {
            return gallons[currentIndex] < gallons[minIndex] ? currentIndex : minIndex;
        }, availableGallons[0]);
    } else if (level == 6) {
        // Level 6: Strategi hampir mustahil, memilih galon dengan Algoritma Sean
      
        // hasil = algoritmaSean(gallons)
        $.ajax({
            url: '/api/get-data-by-algoritma-master',
            method: 'POST',
            dataType: 'json',
            contentType: 'application/json',
            data:JSON.stringify(gallons) ,
            success: function(response){
                 
                 gallonIndex = response.index
                waterAmount = response.amount
                gallons[gallonIndex] -= waterAmount;
            },
            error: function(jqXHR, textStatus, errorThrown) {
              
            }
         })

    } else if (level == 7) {
        // Level 7: Strategi hampir mustahil, memilih galon dengan Algoritma Sean
      
        // hasil = algoritmaSean(gallons)
        $.ajax({
            url: '/api/get-data-by-algoritma-master-lvl7',
            method: 'POST',
            dataType: 'json',
            contentType: 'application/json',
            data:JSON.stringify(gallons) ,
            success: function(response){
                 
                 gallonIndex = response.index
                waterAmount = response.amount
                gallons[gallonIndex] -= waterAmount;
            },
            error: function(jqXHR, textStatus, errorThrown) {
              
            }
         })

    }

    if (level < 6){
        // Komputer mengurangi air dari galon yang dipilih
        waterAmount = Math.floor(Math.random() * gallons[gallonIndex]) + 1; // Mengurangi setidaknya 1 liter
        gallons[gallonIndex] -= waterAmount;
    }
    
    // Delay 3 detik sebelum menampilkan hasil komputer
    setTimeout(() => {
        
        sucAlert(`Komputer mengurangi galon ${gallonIndex + 1} sebanyak ${waterAmount} liter`)

        no = `#ember${gallonIndex+1}`
        $(no).text(gallons[gallonIndex])

        // Periksa apakah semua galon kosong setelah turn komputer
        if (gallons.every(g => g <= 0)) {
            addAlert('Semua galon kosong! Komputer menang.')
            $(".modal-body").text("YOU LOSE")
            myModal.show()
            return
        } else {
          
            playerTurn(level);  // Giliran pemain lagi
        }
    }, 5000); // Delay 5000 ms (5 detik)
}

// A $( document ).ready() block.
$( document ).ready(function() {
  level = <%-lvl%>
  initializeGame()
  startGame(level)
});

</script>